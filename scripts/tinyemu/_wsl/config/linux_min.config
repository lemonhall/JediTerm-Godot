# Kernel fragment: keep TinyEMU virtio console + virtio block + virtio net.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# Network stack
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IP_MULTICAST=y

# HVC console (for earlycon=sbi and hvc0)
CONFIG_HVC_RISCV_SBI=y

# Unaligned access emulation (avoids hang on check_unaligned_access)
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y

# VirtIO RNG (for fast crng init)
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
