[configuration]

entry_symbol = "jediterm_conpty_library_init"
compatibility_minimum = "4.6.0"

[libraries]

# Godot 4.x key formats vary across versions; keep both "debug/release" and explicit "editor/template_*".
# Use template_debug for editor too to avoid requiring a separate "target=editor" build.
windows.x86_64 = "res://addons/jediterm/bin/win64/conpty.windows.template_debug.x86_64.dll"
windows.editor.x86_64 = "res://addons/jediterm/bin/win64/conpty.windows.template_debug.x86_64.dll"
windows.template_debug.x86_64 = "res://addons/jediterm/bin/win64/conpty.windows.template_debug.x86_64.dll"
windows.template_release.x86_64 = "res://addons/jediterm/bin/win64/conpty.windows.template_debug.x86_64.dll"

windows.debug.x86_64 = "res://addons/jediterm/bin/win64/conpty.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/jediterm/bin/win64/conpty.windows.template_debug.x86_64.dll"

# POSIX PTY (macOS / Linux): same library entry symbol, registers `PosixPTY`.
macos.debug = "res://addons/jediterm/bin/macos/conpty.macos.template_debug.dylib"
macos.release = "res://addons/jediterm/bin/macos/conpty.macos.template_release.dylib"
macos.editor = "res://addons/jediterm/bin/macos/conpty.macos.template_debug.dylib"
macos.template_debug = "res://addons/jediterm/bin/macos/conpty.macos.template_debug.dylib"
macos.template_release = "res://addons/jediterm/bin/macos/conpty.macos.template_release.dylib"

# Godot may resolve macOS by including arch in the key (e.g. macos.x86_64).
macos.x86_64 = "res://addons/jediterm/bin/macos/conpty.macos.template_debug.dylib"
macos.editor.x86_64 = "res://addons/jediterm/bin/macos/conpty.macos.template_debug.dylib"
macos.template_debug.x86_64 = "res://addons/jediterm/bin/macos/conpty.macos.template_debug.dylib"
macos.template_release.x86_64 = "res://addons/jediterm/bin/macos/conpty.macos.template_release.dylib"
macos.debug.x86_64 = "res://addons/jediterm/bin/macos/conpty.macos.template_debug.dylib"
macos.release.x86_64 = "res://addons/jediterm/bin/macos/conpty.macos.template_release.dylib"

linux.debug.x86_64 = "res://addons/jediterm/bin/linux/conpty.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/jediterm/bin/linux/conpty.linux.template_release.x86_64.so"
linux.template_debug.x86_64 = "res://addons/jediterm/bin/linux/conpty.linux.template_debug.x86_64.so"
linux.template_release.x86_64 = "res://addons/jediterm/bin/linux/conpty.linux.template_release.x86_64.so"

linux.x86_64 = "res://addons/jediterm/bin/linux/conpty.linux.template_debug.x86_64.so"
linux.editor.x86_64 = "res://addons/jediterm/bin/linux/conpty.linux.template_debug.x86_64.so"
